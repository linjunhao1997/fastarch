{
  "swagger": "2.0",
  "info": {
    "title": "sender/message.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "MessageService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/sender/messages": {
      "post": {
        "summary": "发送消息：生成发送记录并模拟投递（pending→sent）",
        "operationId": "MessageService_SendMessage",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1MessageRecord"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SendMessageRequest"
            }
          }
        ],
        "tags": [
          "MessageService"
        ]
      }
    },
    "/sender/records": {
      "get": {
        "summary": "发送记录分页列表：keyword 模糊匹配接收对象/模板名",
        "operationId": "MessageService_ListMessages",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListMessagesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "currentPage",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "sendStatus",
            "description": "可选状态过滤",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "MessageService"
        ]
      }
    },
    "/sender/records/{id}": {
      "get": {
        "summary": "获取发送记录",
        "operationId": "MessageService_GetMessage",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1MessageRecord"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "MessageService"
        ]
      },
      "delete": {
        "summary": "删除发送记录（业务型模型：逻辑删除）",
        "operationId": "MessageService_DeleteMessage",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "MessageService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1ApplicationSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "t_application.id（string 编码，避免 JS 精度丢失）"
        },
        "code": {
          "type": "string",
          "title": "服务段命名空间（iam/sender…）"
        },
        "name": {
          "type": "string",
          "title": "展示名"
        },
        "status": {
          "type": "string",
          "title": "enabled / disabled"
        }
      },
      "title": "应用展示摘要（跨服务通用，只读回传；仅含展示字段，不含 app_id/密钥等机器字段）。\n用于让列表/详情直接渲染\"归属应用\"，避免前端二次查询应用目录。"
    },
    "v1ListMessagesResponse": {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/definitions/v1Page"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MessageRecord"
          }
        }
      }
    },
    "v1MessageRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "recipient": {
          "type": "string"
        },
        "templateCode": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "sendStatus": {
          "type": "string",
          "title": "pending / sent / failed（字典 send_status）"
        },
        "version": {
          "type": "string",
          "format": "int64"
        },
        "createdBy": {
          "type": "string",
          "title": "审计字段（只读回传，由服务端注入；请求消息不含此类字段，宪法 XII）"
        },
        "updatedBy": {
          "type": "string"
        },
        "createTime": {
          "type": "string",
          "format": "date-time"
        },
        "updateTime": {
          "type": "string",
          "format": "date-time"
        },
        "application": {
          "$ref": "#/definitions/v1ApplicationSummary",
          "title": "归属应用展示摘要（只读回传；sender 宿主应用 id 固定，值来自配置）"
        }
      },
      "title": "发送记录（落库实体，业务型模型）"
    },
    "v1Page": {
      "type": "object",
      "properties": {
        "total": {
          "type": "string",
          "format": "int64",
          "title": "总记录数"
        },
        "currentPage": {
          "type": "string",
          "format": "int64",
          "title": "当前页码"
        },
        "pageSize": {
          "type": "string",
          "format": "int64",
          "title": "每页记录数"
        },
        "totalPages": {
          "type": "string",
          "format": "int64",
          "title": "总页数"
        }
      },
      "title": "分页信息（所有服务的列表响应复用）"
    },
    "v1SendMessageRequest": {
      "type": "object",
      "properties": {
        "recipient": {
          "type": "string",
          "title": "接收对象（地址/标识）"
        },
        "templateCode": {
          "type": "string",
          "title": "可选：所用模板 code"
        },
        "content": {
          "type": "string",
          "title": "渲染后的消息内容"
        },
        "channel": {
          "type": "string",
          "title": "可选：渠道（字典 channel）"
        }
      }
    }
  }
}
