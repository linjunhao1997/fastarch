{
  "swagger": "2.0",
  "info": {
    "title": "iam/authentication.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AuthenticationService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/authentication/my-applications": {
      "get": {
        "summary": "列出当前用户可进入的应用（admin 旁路全部启用应用；\n其他用户按 t_r_user_application 准入绑定过滤）。",
        "operationId": "AuthenticationService_ListMyApplications",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListMyApplicationsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "AuthenticationService"
        ]
      }
    },
    "/authentication/my-profile": {
      "get": {
        "summary": "获取当前登录用户的个人信息（基本信息 + 可进入应用列表）\n仅凭登录态（JWT accountId）返回，不接收用户标识参数",
        "operationId": "AuthenticationService_GetMyProfile",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetMyProfileResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "AuthenticationService"
        ]
      }
    },
    "/authentication/password-auth": {
      "post": {
        "summary": "密码认证：identifier 即登录标识（username 或 email，服务端双路径查询）",
        "operationId": "AuthenticationService_PasswordAuth",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PasswordAuthResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1PasswordAuthRequest"
            }
          }
        ],
        "tags": [
          "AuthenticationService"
        ]
      }
    },
    "/authentication/select-application": {
      "post": {
        "summary": "选择当前应用上下文：校验准入后写入 jti→应用映射（切换不重签令牌，\n多应用裁决 #8）。外部/机器令牌的 application_id 在签发时锁定于 claim，\n不经本接口。",
        "operationId": "AuthenticationService_SelectApplication",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SelectApplicationRequest"
            }
          }
        ],
        "tags": [
          "AuthenticationService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1GetMyProfileResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "用户基本信息（不含密码摘要、AK/SK 等敏感凭据字段）"
        },
        "username": {
          "type": "string",
          "title": "登录名（唯一）"
        },
        "nickname": {
          "type": "string",
          "title": "显示名（可空）"
        },
        "email": {
          "type": "string",
          "title": "邮箱（可空，唯一）"
        },
        "status": {
          "type": "string",
          "title": "\"enabled\" 启用，\"disabled\" 禁用"
        },
        "createdBy": {
          "type": "string",
          "description": "创建人（用户 id）",
          "title": "审计字段（只读回传，服务端注入）"
        },
        "createTime": {
          "type": "string",
          "format": "date-time",
          "title": "创建时间"
        },
        "applications": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MyProfileApplication"
          },
          "title": "可进入应用列表（与 ListMyApplications 同源：admin 全量启用应用，其他按准入绑定）"
        }
      }
    },
    "v1ListMyApplicationsResponse": {
      "type": "object",
      "properties": {
        "applications": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MyProfileApplication"
          }
        }
      }
    },
    "v1MyProfileApplication": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "应用 id（string 编码）"
        },
        "code": {
          "type": "string",
          "title": "应用编码"
        },
        "name": {
          "type": "string",
          "title": "应用名称"
        },
        "status": {
          "type": "string",
          "title": "启用/停用状态"
        }
      },
      "title": "账号归属的应用摘要（个人信息用；含停用应用，前端置灰不可选）"
    },
    "v1PasswordAuthRequest": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "title": "登录标识：username 或 email（双标识登录，011 裁决）"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "v1PasswordAuthResponse": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        }
      }
    },
    "v1SelectApplicationRequest": {
      "type": "object",
      "properties": {
        "applicationCode": {
          "type": "string",
          "title": "应用服务段编码（人机边界认 code，服务端换 application_id；多应用裁决 #8）"
        }
      }
    }
  }
}
