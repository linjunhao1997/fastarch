{
  "swagger": "2.0",
  "info": {
    "title": "iam/authentication.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AuthenticationService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/authentication/my-profile": {
      "get": {
        "summary": "获取当前登录用户的个人信息（基本信息）\r\n仅凭登录态（JWT accountId）返回，不接收用户标识参数",
        "operationId": "AuthenticationService_GetMyProfile",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetMyProfileResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "AuthenticationService"
        ]
      }
    },
    "/authentication/password-auth": {
      "post": {
        "summary": "密码认证：identifier 即登录标识（username 或 email，服务端双路径查询）。\r\n目标应用由 gRPC metadata 的 application_code 决定（人机边界认 code）。\r\n自有控制台登录可不带该 metadata（缺省回退 iam 应用）；外部应用（如 sender）\r\n经内部 gRPC 调用时在出站 metadata 中携带自身 code，登录即锁定所属应用。",
        "operationId": "AuthenticationService_PasswordAuth",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PasswordAuthResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1PasswordAuthRequest"
            }
          }
        ],
        "tags": [
          "AuthenticationService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1ApplicationSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "t_application.id（string 编码，避免 JS 精度丢失）"
        },
        "code": {
          "type": "string",
          "title": "服务段命名空间（iam/sender…）"
        },
        "name": {
          "type": "string",
          "title": "展示名"
        },
        "status": {
          "type": "string",
          "title": "enabled / disabled"
        }
      },
      "title": "应用展示摘要（跨服务通用，只读回传；仅含展示字段，不含 app_id/密钥等机器字段）。\n用于让列表/详情直接渲染\"归属应用\"，避免前端二次查询应用目录。"
    },
    "v1GetMyProfileResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "用户基本信息（不含密码摘要、AK/SK 等敏感凭据字段）"
        },
        "username": {
          "type": "string",
          "title": "登录名（唯一）"
        },
        "nickname": {
          "type": "string",
          "title": "显示名（可空）"
        },
        "email": {
          "type": "string",
          "title": "邮箱（可空，唯一）"
        },
        "status": {
          "type": "string",
          "title": "\"enabled\" 启用，\"disabled\" 禁用"
        },
        "createdBy": {
          "type": "string",
          "description": "创建人（用户 id）",
          "title": "审计字段（只读回传，服务端注入）"
        },
        "createTime": {
          "type": "string",
          "format": "date-time",
          "title": "创建时间"
        },
        "isAdmin": {
          "type": "boolean",
          "title": "是否 admin 角色（只读回传，服务端派生）：前端据此决定是否放开数据边界 UI"
        },
        "applications": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ApplicationSummary"
          },
          "title": "用户可切换的数据归属应用清单（接入集合）：登录后应用选择页与左上角\r\n数据范围下拉的唯一数据源。admin 返回全部启用应用。"
        }
      }
    },
    "v1PasswordAuthRequest": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "title": "登录标识：username 或 email（双标识登录，011 裁决）"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "v1PasswordAuthResponse": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        }
      }
    }
  }
}
