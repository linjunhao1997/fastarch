{
  "swagger": "2.0",
  "info": {
    "title": "iam/credential.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AccessCredentialService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/authentication/access-credentials": {
      "get": {
        "summary": "凭证分页列表：支持按 account_id / access_key / status 筛选；全量业务字段（不含 secret_key）",
        "operationId": "AccessCredentialService_ListAccessCredentials",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAccessCredentialsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "currentPage",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "accountId",
            "description": "筛选条件，均可空 = 不筛",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "accessKey",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "AccessCredentialService"
        ]
      },
      "post": {
        "summary": "创建凭证，响应中一次性返回明文 secret_key（之后任何接口不再返回，FR-002）",
        "operationId": "AccessCredentialService_CreateAccessCredential",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateAccessCredentialResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateAccessCredentialRequest"
            }
          }
        ],
        "tags": [
          "AccessCredentialService"
        ]
      }
    },
    "/authentication/access-credentials/{id}": {
      "get": {
        "summary": "凭证详情：全量业务字段（不含 secret_key）",
        "operationId": "AccessCredentialService_GetAccessCredential",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1AccessCredential"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "AccessCredentialService"
        ]
      },
      "delete": {
        "summary": "删除凭证：物理删除（基础架构型模型，宪法 XIV），服务端完成引用校验并记录审计日志",
        "operationId": "AccessCredentialService_DeleteAccessCredential",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "AccessCredentialService"
        ]
      },
      "patch": {
        "summary": "修改凭证可编辑字段全集：remark、expire_time（审计字段不可入参，宪法 XII）",
        "operationId": "AccessCredentialService_UpdateAccessCredential",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "remark": {
                  "type": "string"
                },
                "expireTime": {
                  "type": "string",
                  "format": "date-time"
                },
                "version": {
                  "type": "string",
                  "format": "int64"
                }
              }
            }
          }
        ],
        "tags": [
          "AccessCredentialService"
        ]
      }
    },
    "/authentication/access-credentials/{id}/reset-secret": {
      "post": {
        "summary": "重置 SK：AK 不变，生成新 SK 一次性返回，旧 SK 立即失效（FR-008）",
        "operationId": "AccessCredentialService_ResetAccessCredentialSecret",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ResetAccessCredentialSecretResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object"
            }
          }
        ],
        "tags": [
          "AccessCredentialService"
        ]
      }
    },
    "/authentication/access-credentials/{id}/status": {
      "post": {
        "summary": "启用/禁用凭证（非 CRUD 动作，POST + 动作语义，宪法 XIV）；幂等",
        "operationId": "AccessCredentialService_ChangeAccessCredentialStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "title": "目标状态：\"enabled\" 启用，\"disabled\" 禁用"
                }
              }
            }
          }
        ],
        "tags": [
          "AccessCredentialService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1AccessCredential": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "雪花 ID（string 编码）"
        },
        "accessKey": {
          "type": "string",
          "title": "AK，FAK 前缀，全局唯一，创建后不可变"
        },
        "accountId": {
          "type": "string",
          "title": "绑定账号 id（string 编码）"
        },
        "accountName": {
          "type": "string",
          "title": "绑定账号名（服务端组装，只读）"
        },
        "remark": {
          "type": "string",
          "title": "备注用途"
        },
        "status": {
          "type": "string",
          "title": "状态：\"enabled\" 启用，\"disabled\" 禁用（与账号状态取值一致）"
        },
        "expireTime": {
          "type": "string",
          "format": "date-time",
          "title": "可空：永不过期"
        },
        "lastUsedTime": {
          "type": "string",
          "format": "date-time",
          "title": "可空：从未使用（节流更新，分钟级精度）"
        },
        "version": {
          "type": "string",
          "format": "int64",
          "title": "乐观锁版本号"
        },
        "createdBy": {
          "type": "string",
          "title": "审计字段（只读回传，由服务端注入；请求消息不含此类字段，宪法 XII）"
        },
        "updatedBy": {
          "type": "string"
        },
        "createTime": {
          "type": "string",
          "format": "date-time"
        },
        "updateTime": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "访问凭证（不含 secret_key——明文仅出现在创建/重置响应中）"
    },
    "v1CreateAccessCredentialRequest": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "format": "int64",
          "title": "绑定账号 id；账号必须存在且启用（FR-004）"
        },
        "remark": {
          "type": "string"
        },
        "expireTime": {
          "type": "string",
          "format": "date-time",
          "title": "过期时间；可空 = 永不过期"
        }
      }
    },
    "v1CreateAccessCredentialResponse": {
      "type": "object",
      "properties": {
        "credential": {
          "$ref": "#/definitions/v1AccessCredential"
        },
        "secretKey": {
          "type": "string",
          "title": "一次性明文 SK，仅此响应返回"
        }
      }
    },
    "v1ListAccessCredentialsResponse": {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/definitions/v1Page"
        },
        "accessCredentials": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1AccessCredential"
          }
        }
      }
    },
    "v1Page": {
      "type": "object",
      "properties": {
        "total": {
          "type": "string",
          "format": "int64",
          "title": "总记录数"
        },
        "currentPage": {
          "type": "string",
          "format": "int64",
          "title": "当前页码"
        },
        "pageSize": {
          "type": "string",
          "format": "int64",
          "title": "每页记录数"
        },
        "totalPages": {
          "type": "string",
          "format": "int64",
          "title": "总页数"
        }
      },
      "title": "分页信息（所有服务的列表响应复用）"
    },
    "v1ResetAccessCredentialSecretResponse": {
      "type": "object",
      "properties": {
        "credential": {
          "$ref": "#/definitions/v1AccessCredential"
        },
        "secretKey": {
          "type": "string",
          "title": "一次性明文新 SK"
        }
      }
    }
  }
}
