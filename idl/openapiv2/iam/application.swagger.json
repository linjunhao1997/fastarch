{
  "swagger": "2.0",
  "info": {
    "title": "iam/application.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "ApplicationService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/application/applications": {
      "get": {
        "summary": "获取应用列表（不回传 secret）",
        "operationId": "ApplicationService_ListApplications",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListApplicationsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "currentPage",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "ApplicationService"
        ]
      },
      "post": {
        "summary": "创建应用：服务端生成 app_id 与随机 secret，响应一次性返回 secret 明文\n（服务端只存 sha256 摘要，之后任何接口不再返回）",
        "operationId": "ApplicationService_CreateApplication",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateApplicationResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateApplicationRequest"
            }
          }
        ],
        "tags": [
          "ApplicationService"
        ]
      }
    },
    "/application/applications/{id}": {
      "get": {
        "summary": "获取应用信息（不回传 secret）",
        "operationId": "ApplicationService_GetApplication",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Application"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "ApplicationService"
        ]
      },
      "delete": {
        "summary": "删除应用（仅当未被授权数据引用时可删除）",
        "operationId": "ApplicationService_DeleteApplication",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "ApplicationService"
        ]
      },
      "patch": {
        "summary": "修改应用信息（name/status）",
        "operationId": "ApplicationService_UpdateApplication",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "title": "以下字段缺省（空串）= 不修改"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "tags": [
          "ApplicationService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1Application": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "appId": {
          "type": "string",
          "title": "应用标识（服务端生成，唯一）"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "title": "应用状态：\"enabled\" 启用，\"disabled\" 禁用"
        },
        "version": {
          "type": "string",
          "format": "int64"
        },
        "createdBy": {
          "type": "string",
          "description": "创建人（用户 id）",
          "title": "审计字段（只读回传，由服务端注入；请求消息不含此类字段，宪法 XII）"
        },
        "updatedBy": {
          "type": "string",
          "title": "修改人（用户 id）"
        },
        "createTime": {
          "type": "string",
          "format": "date-time",
          "title": "创建时间"
        },
        "updateTime": {
          "type": "string",
          "format": "date-time",
          "title": "修改时间"
        }
      },
      "title": "应用信息（t_application 全列；不含 secret 摘要等敏感字段，宪法 XII）"
    },
    "v1CreateApplicationRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "title": "应用状态：\"enabled\" 启用，\"disabled\" 禁用；缺省为 enabled"
        }
      }
    },
    "v1CreateApplicationResponse": {
      "type": "object",
      "properties": {
        "application": {
          "$ref": "#/definitions/v1Application"
        },
        "secret": {
          "type": "string",
          "title": "一次性返回的 secret 明文（服务端仅存 sha256 hex 摘要），仅此响应可见"
        }
      }
    },
    "v1ListApplicationsResponse": {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/definitions/v1Page"
        },
        "applications": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Application"
          }
        }
      }
    },
    "v1Page": {
      "type": "object",
      "properties": {
        "total": {
          "type": "string",
          "format": "int64",
          "title": "总记录数"
        },
        "currentPage": {
          "type": "string",
          "format": "int64",
          "title": "当前页码"
        },
        "pageSize": {
          "type": "string",
          "format": "int64",
          "title": "每页记录数"
        },
        "totalPages": {
          "type": "string",
          "format": "int64",
          "title": "总页数"
        }
      },
      "title": "分页信息（所有服务的列表响应复用）"
    }
  }
}
