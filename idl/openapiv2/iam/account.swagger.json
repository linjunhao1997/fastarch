{
  "swagger": "2.0",
  "info": {
    "title": "iam/account.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AccountService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/account/accounts": {
      "get": {
        "summary": "获取用户列表：keyword 模糊匹配 username/nickname/email",
        "operationId": "AccountService_ListAccounts",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAccountsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "currentPage",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "keyword",
            "description": "模糊匹配 username/nickname/email",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "AccountService"
        ]
      },
      "post": {
        "summary": "创建用户：初始密码必填（bcrypt 落库），接入应用必填（数据边界 ADR 0008），\r\n返回创建出的用户（含 id 与准入应用回填）",
        "operationId": "AccountService_CreateAccount",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Account"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateAccountRequest"
            }
          }
        ],
        "tags": [
          "AccountService"
        ]
      }
    },
    "/account/accounts/{accountId}/applications": {
      "patch": {
        "summary": "设置用户准入应用（ADR 0008）：application_ids 全量覆盖语义，空数组 = 清空接入集合。",
        "operationId": "AccountService_UpdateAccountApplications",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "applicationIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "title": "目标应用 id 集合（string 编码）：全量覆盖语义，空数组 = 清空接入集合"
                }
              }
            }
          }
        ],
        "tags": [
          "AccountService"
        ]
      }
    },
    "/account/accounts/{accountId}/roles": {
      "patch": {
        "operationId": "AccountService_UpdateAccountRoles",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "addedRoleIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "title": "待绑定/解绑的角色 id（t_role.id，全局唯一）；按 id 承载以消解跨应用同名码歧义，\r\n超管可跨应用分配，非 admin 由服务端按 dataAppId 校验归属（ADR-0009）。"
                },
                "removedRoleIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ],
        "tags": [
          "AccountService"
        ]
      }
    },
    "/account/accounts/{id}": {
      "get": {
        "summary": "获取用户信息",
        "operationId": "AccountService_GetAccount",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Account"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "AccountService"
        ]
      },
      "delete": {
        "operationId": "AccountService_DeleteAccount",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "AccountService"
        ]
      },
      "patch": {
        "summary": "修改用户：nickname/email/status 可选更新（字段缺省 = 不修改）",
        "operationId": "AccountService_UpdateAccount",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nickname": {
                  "type": "string",
                  "title": "以下字段缺省（空串）= 不修改（与现有更新风格一致）"
                },
                "email": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "title": "用户状态：\"enabled\" 启用，\"disabled\" 禁用；缺省不修改"
                },
                "version": {
                  "type": "string",
                  "format": "int64",
                  "title": "乐观锁版本号"
                }
              }
            }
          }
        ],
        "tags": [
          "AccountService"
        ]
      }
    },
    "/account/accounts/{id}/reset-password": {
      "post": {
        "summary": "管理员重置用户密码：新密码 bcrypt 落库，不要求提供旧密码",
        "operationId": "AccountService_ResetAccountPassword",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "newPassword": {
                  "type": "string",
                  "title": "新密码（管理员重置，无需旧密码）"
                }
              }
            }
          }
        ],
        "tags": [
          "AccountService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1Account": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "username": {
          "type": "string",
          "title": "唯一登录名"
        },
        "email": {
          "type": "string",
          "title": "邮箱（可空，唯一）"
        },
        "nickname": {
          "type": "string",
          "title": "显示名（可空）"
        },
        "status": {
          "type": "string",
          "title": "用户状态（只读回传）：\"enabled\" 启用，\"disabled\" 禁用"
        },
        "version": {
          "type": "string",
          "format": "int64"
        },
        "roleCodeList": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "绑定的角色编码清单（只读回传）"
        },
        "createdBy": {
          "type": "string",
          "description": "创建人（用户 id）",
          "title": "审计字段（只读回传，由服务端注入；请求消息不含此类字段，宪法 XII）"
        },
        "updatedBy": {
          "type": "string",
          "title": "修改人（用户 id）"
        },
        "createTime": {
          "type": "string",
          "format": "date-time",
          "title": "创建时间"
        },
        "updateTime": {
          "type": "string",
          "format": "date-time",
          "title": "修改时间"
        },
        "applications": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1AccountApplication"
          },
          "title": "可接入的应用清单（只读回传；GetAccount 与 ListAccounts 均回填，含展示字段，\r\n前端直接渲染，无需二次查询应用目录）"
        },
        "roleIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "已绑角色 id（t_role.id，string 编码，只读回传）：与 role_code_list 同源且\r\n同序，按操作者数据范围过滤（ADR-0009）。绑定接口按 id 承载，前端据此回填\r\n已选角色，避免跨应用同名码无法反查唯一 id。"
        }
      },
      "title": "用户信息（t_user 语义；不含密码摘要等敏感字段，宪法 XII）"
    },
    "v1AccountApplication": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "title": "服务段命名空间（iam/order…）"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "title": "enabled / disabled"
        }
      },
      "title": "准入应用摘要（用户详情/列表展示用；不含 app_id/密钥等机器字段，宪法 XII）"
    },
    "v1CreateAccountRequest": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "title": "邮箱可选；空串经 ignore=IGNORE_IF_ZERO_VALUE 显式跳过，非空时必须合法"
        },
        "password": {
          "type": "string",
          "title": "初始密码必填（bcrypt 摘要落库，明文不落盘）"
        },
        "roleIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "初始角色 id 集合（string 编码），可选；缺省不绑定角色"
        },
        "applicationIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "接入应用 id 集合（string 编码）：必填，至少一个且必须已启用（数据边界 ADR 0008）；\r\n非 admin 只能创建接入应用包含操作者数据边界应用的用户"
        }
      }
    },
    "v1ListAccountsResponse": {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/definitions/v1Page"
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Account"
          }
        }
      }
    },
    "v1Page": {
      "type": "object",
      "properties": {
        "total": {
          "type": "string",
          "format": "int64",
          "title": "总记录数"
        },
        "currentPage": {
          "type": "string",
          "format": "int64",
          "title": "当前页码"
        },
        "pageSize": {
          "type": "string",
          "format": "int64",
          "title": "每页记录数"
        },
        "totalPages": {
          "type": "string",
          "format": "int64",
          "title": "总页数"
        }
      },
      "title": "分页信息（所有服务的列表响应复用）"
    }
  }
}
