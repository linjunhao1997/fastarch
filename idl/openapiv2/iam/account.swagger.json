{
  "swagger": "2.0",
  "info": {
    "title": "iam/account.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AccountService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/account/accounts": {
      "get": {
        "summary": "获取账号列表",
        "operationId": "AccountService_ListAccounts",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListAccountsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "currentPage",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "AccountService"
        ]
      },
      "post": {
        "summary": "创建账号，返回创建出的账号（含 id）",
        "operationId": "AccountService_CreateAccount",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Account"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateAccountRequest"
            }
          }
        ],
        "tags": [
          "AccountService"
        ]
      }
    },
    "/account/accounts/{accountId}/roles": {
      "patch": {
        "operationId": "AccountService_UpdateAccountRoles",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "addedRoleCodeList": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "removedRoleCodeList": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ],
        "tags": [
          "AccountService"
        ]
      }
    },
    "/account/accounts/{id}": {
      "get": {
        "summary": "获取账号信息",
        "operationId": "AccountService_GetAccount",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Account"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "AccountService"
        ]
      },
      "delete": {
        "operationId": "AccountService_DeleteAccount",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "AccountService"
        ]
      },
      "patch": {
        "summary": "修改账号",
        "operationId": "AccountService_UpdateAccount",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "version": {
                  "type": "string",
                  "format": "int64"
                },
                "applicationIdList": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "int64"
                  },
                  "title": "账号归属的应用 id 集合；presence + 全量替换语义 —— 字段缺省=不修改归属，\r\n显式传入（含空数组）时以本集合为目标归属集合做差集增删\r\n（与 UpdateAccountRolesRequest 的 added/removed 增量语义不同）"
                }
              }
            }
          }
        ],
        "tags": [
          "AccountService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1Account": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "title": "账号类型：\"0\" 用户，\"1\" 系统"
        },
        "roleCodeList": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string",
          "format": "int64"
        },
        "createdBy": {
          "type": "string",
          "description": "创建人（账号 id）",
          "title": "审计字段（只读回传，由服务端注入；请求消息不含此类字段，宪法 XII）"
        },
        "updatedBy": {
          "type": "string",
          "title": "修改人（账号 id）"
        },
        "createTime": {
          "type": "string",
          "format": "date-time",
          "title": "创建时间"
        },
        "updateTime": {
          "type": "string",
          "format": "date-time",
          "title": "修改时间"
        },
        "applicationIdList": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "账号当前归属的应用 id 集合（只读回传）"
        },
        "status": {
          "type": "string",
          "title": "账号状态（只读回传）：\"enabled\" 启用，\"disabled\" 禁用"
        }
      },
      "title": "账号信息"
    },
    "v1CreateAccountRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "title": "账号类型：\"0\" 用户，\"1\" 系统"
        },
        "applicationIdList": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "int64"
          },
          "title": "账号归属的应用 id 集合；可为空（允许无归属账号）"
        },
        "status": {
          "type": "string",
          "title": "账号状态：\"enabled\" 启用，\"disabled\" 禁用；缺省为 enabled"
        }
      }
    },
    "v1ListAccountsResponse": {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/definitions/v1Page"
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Account"
          }
        }
      }
    },
    "v1Page": {
      "type": "object",
      "properties": {
        "total": {
          "type": "string",
          "format": "int64",
          "title": "总记录数"
        },
        "currentPage": {
          "type": "string",
          "format": "int64",
          "title": "当前页码"
        },
        "pageSize": {
          "type": "string",
          "format": "int64",
          "title": "每页记录数"
        },
        "totalPages": {
          "type": "string",
          "format": "int64",
          "title": "总页数"
        }
      },
      "title": "分页信息（所有服务的列表响应复用）"
    }
  }
}
