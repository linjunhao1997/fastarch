    "v1ApplicationSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "t_application.id（string 编码，避免 JS 精度丢失）"
        },
        "code": {
          "type": "string",
          "title": "服务段命名空间（iam/sender…）"
        },
        "name": {
          "type": "string",
          "title": "展示名"
        },
        "status": {
          "type": "string",
          "title": "enabled / disabled"
        }
      },
      "title": "应用展示摘要（跨服务通用，只读回传；仅含展示字段，不含 app_id/密钥等机器字段）。\n用于让列表/详情直接渲染\"归属应用\"，避免前端二次查询应用目录。"
    },
    "v1CheckPermissionRequest": {
      "type": "object",
      "properties": {
        "permissionCode": {
          "type": "string"
        }
      },
      "title": "检查权限"
    },
    "v1CheckPermissionResponse": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "dataAppId": {
          "type": "string",
          "format": "int64",
          "title": "data_app_id 是本次请求经拦截器校验后的数据归属应用 id（来自 appCode 或凭证归属）。\n供下游服务（如 sender）据此隔离数据，无需自持应用目录或信任未验签 claim。"
        }
      }
    },
    "v1CreatePermissionRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "title": "权限码是唯一授权词汇，格式为 服务.模块.操作，如 iam.user.delete"
