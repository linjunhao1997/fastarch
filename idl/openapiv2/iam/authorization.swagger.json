        "updatedBy": {
          "type": "string",
          "title": "修改人（用户 id）"
        },
        "createTime": {
          "type": "string",
          "format": "date-time",
          "title": "创建时间"
        },
        "updateTime": {
          "type": "string",
          "format": "date-time",
          "title": "修改时间"
        },
        "application": {
          "$ref": "#/definitions/v1ApplicationSummary",
          "title": "归属应用展示摘要（只读回传，便于列表/详情直接渲染，免二次查询）。\n语义：码归属应用（管理数据边界，ADR 0006）；与全局授权词汇语义正交。"
        }
      },
      "title": "权限信息。权限码（permission_code）是唯一授权词汇，\n格式为 服务.模块.操作（如 iam.user.delete）。"
    },
